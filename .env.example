# SP Demo Builder — environment variables
# Copy to .env for local dev. On Heroku these are set via `heroku config:set`.
# NEVER commit real secrets. .env is gitignored.

# --- Runtime ---
NODE_ENV=development
PORT=3000
# Public base URL of this app. Used to build hosted /e/:uuid links and OAuth callbacks.
# Local: http://localhost:3000  |  Heroku: https://<your-app>.herokuapp.com
APP_BASE_URL=http://localhost:3000

# --- Postgres (Heroku add-on provides DATABASE_URL automatically) ---
DATABASE_URL=postgres://localhost:5432/sp_demo_builder

# --- Sessions ---
# Random 32-byte hex. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Token encryption at rest (AES-256-GCM) ---
# Random 32-byte hex (separate from SESSION_SECRET). Encrypts Salesforce tokens in the DB.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=

# --- Google Sign-In (passport-google-oauth20) ---
# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client (Web application).
# Authorized redirect URI must be <APP_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated list of allowed email domains. Defaults to salesforce.com.
GOOGLE_ALLOWED_DOMAINS=salesforce.com

# --- Salesforce Connected App (one app for both prod + sandbox) ---
# OAuth scopes: full, refresh_token, offline_access, web
# Callback URL registered on the Connected App must be <APP_BASE_URL>/auth/salesforce/callback
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_CALLBACK_URL=http://localhost:3000/auth/salesforce/callback
# Salesforce API version used for describe calls + Personalization Connect API.
SF_API_VERSION=67.0

# --- Cloudinary (host extracted hero images for Personalization Decisions) ---
# The sim inlines hero images as base64 data URIs; decisions need a short hosted
# URL. App uploads via an UNSIGNED preset (no secret needed). If unset, image is
# simply omitted from the decision (text still lands).
CLOUDINARY_CLOUD_NAME=dfx98jgdc
CLOUDINARY_UPLOAD_PRESET=salesforcepersonalization
